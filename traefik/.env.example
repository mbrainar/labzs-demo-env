# Copy this file to .env and fill in real values. .env is gitignored.

# Email used for Let's Encrypt account registration / expiry notices
ACME_EMAIL=admin@labzs.com

# IAM credentials with route53:GetChange, route53:ChangeResourceRecordSets,
# and route53:ListHostedZonesByName permissions on the labzs.com zone
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional: restricts DNS-01 challenges to this hosted zone (recommended
# if the IAM user only has access to one zone)
AWS_HOSTED_ZONE_ID=
